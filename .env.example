# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (future)
DATABASE_URL=postgresql://user:password@localhost:5432/docucraft

# Auth (future)
AUTH_SECRET=replace-with-a-secure-secret
NEXTAUTH_URL=http://localhost:3000

# Payment (future)
